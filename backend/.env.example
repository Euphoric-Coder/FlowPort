# FlowPort Version 1.1 - Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection (NeonDB Managed PostgreSQL)
# Pooled connection string for application runtime:
DATABASE_URL=postgresql://USER:PASSWORD@ep-sample-pooler.region.neon.tech/flowport?sslmode=require

# Direct connection string for Drizzle migrations:
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-sample.region.neon.tech/flowport?sslmode=require
